{
  // Site de Studio Atlas Rimouski, servi par Cloudflare Workers.
  // Chaque fusion dans main redéploie automatiquement le site (Workers Builds).
  "name": "studioatlasrimouski",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/img/*"]
  },
  // Formulaire de contact : envoi au Gmail de l'entreprise (adresse vérifiée dans Email Routing).
  "send_email": [
    { "name": "EMAIL", "destination_address": "studioatlasrimouski@gmail.com" }
  ],
  // Tableau de bord /admin : visites, messages, clients.
  "d1_databases": [
    { "binding": "DB", "database_name": "atlas-admin", "database_id": "387f602d-53a0-405e-914e-20c073c457e0" }
  ],
  // Photos des sites d'exemple : générées une fois par IA, gardées dans KV, servies sous /img/.
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "5871ec73251c47649a8e8aea64b5ac84" }
  ],
  // Plus de tâche planifiée : les photos sont toutes générées. Liste vide = aucun cron.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
